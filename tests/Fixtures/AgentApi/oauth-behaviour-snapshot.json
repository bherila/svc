            ],
            "grant_types": [
                "authorization_code",
                "refresh_token"
            ],
            "response_types": [
                "code"
            ],
            "token_endpoint_auth_method": "none",
            "scope": "mcp:use identity:read"
        }
    },
    "registration_refusals": {
        "confidential": {
            "status": 400,
            "error": "invalid_client_metadata"
        },
        "insecure_redirect": {
            "status": 400,
            "error": "invalid_client_metadata"
        },
        "unknown_scope": {

            "status": 302,
            "redirects_to_client": true,
            "error": "invalid_scope",
            "state": "snapshot-state",
            "consent_prepared": false
        },
        "unknown_scope": {
            "status": 302,
            "redirects_to_client": true,
            "error": "invalid_scope",
            "state": "snapshot-state",
            "consent_prepared": false
        },
        "other_resource": {
            "status": 302,
            "redirects_to_client": true,
            "error": "invalid_target",
            "state": "snapshot-state",
            "consent_prepared": false
        }
    },
    "consent": {
        "status": 200,
        "no_store": true,
        "shows": [
            "Connect Snapshot client to SVC?",
            "This application is requesting access to your SVC account.",
            "Only continue if you recognize and trust this application. You can revoke the connection later.",
            "This application registered automatically. After approval, your browser returns to:",
            "http://127.0.0.1:3210/callback",
            "SVC permissions and current workspace and project roles still apply to every request.",
            "Authorize",
            "Cancel"
        ],
        "scope_descriptions": [
            "Connect to SVC through MCP",
            "Read your SVC identity and available workspaces"
        ]
    },
    "approval": {
        "status": 302,
        "keys": [
            "code",
            "state"
        ]
    },
    "token_without_verifier": {
        "status": 400,
        "error": "invalid_request"
    },
    "token": {
        "status": 200,
        "keys": [
            "access_token",
            "expires_in",
            "refresh_token",
            "token_type"
        ],
        "token_type": "Bearer"
    },
    "mcp_challenge": {
        "status": 401,
        "www_authenticate": "Bearer resource_metadata=\"http://localhost:8000/.well-known/oauth-protected-resource/api/v1/mcp\""

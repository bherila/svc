{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bherila/svc",
    "description": "Client-service business operations platform.",
    "type": "project",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "bherila/auth-laravel": "^0.9",
        "bherila/mcp-laravel-bridge": "^0.1.0",
        "dompdf/dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/passport": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "mcp/sdk": "^0.7.1",
        "stripe/stripe-php": "^21.0",
        "symfony/brevo-mailer": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.24",
        "infection/infection": "^0.35.3",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "phpunit/phpunit": "^12.5.23",
        "spaze/phpstan-disallowed-calls": "^4.14"
    },
    "repositories": [
        {
            "name": "mcp-laravel-bridge",
            "type": "vcs",
            "url": "git@github.com:bherila/mcp-laravel-bridge.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "registry:manifest": [
            "@php scripts/registry-manifest.php"
        ],
        "mcp:smoke": [
            "@php scripts/mcp-smoke.php"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm run lint:check",
            "pnpm run format:check",
            "pnpm run types:check",
            "pnpm run test",
            "pnpm run scan-sensitive:test",
            "pnpm run scan-sensitive",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G",
            "phpstan analyse --configuration=phpstan-strict.neon --memory-limit=1G app/Services/Billing app/Services/ExternalImport app/Support/Billing"
        ],
        "test:mutation-diff": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d pcov.enabled=1 -d memory_limit=1G vendor/bin/infection --configuration=infection.diff.json5 --git-diff-lines --git-diff-base=origin/main --with-uncovered --only-covering-test-cases --min-msi=82 --threads=max --initial-tests-php-options='-d pcov.enabled=1 -d memory_limit=1G'"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d pcov.enabled=1 -d memory_limit=1G vendor/bin/infection --with-uncovered --only-covering-test-cases --min-msi=82 --threads=max --initial-tests-php-options='-d pcov.enabled=1 -d memory_limit=1G'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test --parallel --processes=4"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php scripts/neutralise-vendor-agent-hints.php"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "bherila/mcp-laravel-bridge": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}

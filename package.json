{
    "name": "@bherila/svc",
    "packageManager": "pnpm@11.5.0",
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.15.0 <25.0.0"
    },
    "scripts": {
        "blobs": "bash scripts/blobs.sh",
        "db-snapshot": "bash scripts/db-snapshot.sh",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "hooks:install": "git config core.hooksPath .githooks",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "scan-sensitive": "node scripts/scan-sensitive.mjs",
        "scan-sensitive:test": "node scripts/test-sensitive-scan.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^24.13.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@inertiajs/react": "^3.7.0",
        "@inertiajs/vite": "^3.7.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.5",
        "globals": "^17.11.0",
        "laravel-vite-plugin": "^3.2.0",
        "lucide-react": "^1.34.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "shadcn": "^4.19.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.2"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.3",
        "@rollup/rollup-linux-x64-gnu": "4.62.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
}

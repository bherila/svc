{
  "name": "@bherila/svc",
  "packageManager": "pnpm@12.15.0",
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/spotlight-noindex.mjs",
    "blobs": "bash scripts/blobs.sh",
    "db-snapshot": "bash scripts/db-snapshot.sh",
    "build": "vite build && node scripts/check-production-pages.mjs",
    "build:ssr": "pnpm run build && vite build --ssr",
    "dev": "vite",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "hooks:install": "git config core.hooksPath .githooks",
    "skills:install": "bash scripts/install-skills.sh",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware",
    "scan-sensitive": "node scripts/scan-sensitive.mjs",
    "scan-sensitive:test": "node scripts/test-sensitive-scan.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit",
    "api:types": "pnpm --package=openapi-typescript@7.13.0 --package=typescript@npm:@typescript/typescript6@6.0.2 dlx openapi-typescript public/openapi/svc-agent-v1.json -o resources/js/types/api.generated.ts && prettier --write resources/js/types/api.generated.ts",
    "api:types:check": "pnpm run api:types && git diff --exit-code -- resources/js/types/api.generated.ts",
    "test:layout": "node scripts/check-layout.mjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@laravel/vite-plugin-wayfinder": "^0.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "spotlight-noindex": "1.1.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@inertiajs/react": "^3.9.1",
    "@inertiajs/vite": "^3.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bwh-auth": "0.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.6",
    "laravel-vite-plugin": "^3.2.0",
    "lucide-react": "^1.62.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.5",
    "@rollup/rollup-linux-x64-gnu": "4.65.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
}

APP_NAME=SVC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SVC_FILESYSTEM_DISK=svc_files
SVC_FILESYSTEM_ROOT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER options: hybrid (Brevo API -> SMTP failover), brevo (Brevo API only), smtp, log
MAIL_MAILER=hybrid
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Brevo v3 API key DSN, e.g. brevo+api://xkeysib-YOUR_KEY@default
MAILER_DSN=
# Shared secret for the Brevo delivery-status webhook. Point Brevo at
# POST /api/webhooks/brevo and have it send this as an X-Webhook-Token header
# or an Authorization: Bearer header. Query-string credentials are rejected.
# Leave it unset and the endpoint refuses every request, which is the safe state
# for a deployment that has not configured it.
BREVO_WEBHOOK_TOKEN=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OAUTH_PROVIDER=identity
OAUTH_PROVIDER_URL=https://id.bherila.net
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI="${APP_URL}/oauth/callback"

# Exact comma-separated browser origins allowed to call the remote MCP endpoint.
# Native MCP clients that send no Origin header do not need to be listed.
AGENT_API_MCP_ALLOWED_ORIGINS=
AGENT_API_DYNAMIC_CLIENT_RETENTION_DAYS=30
AGENT_API_WRITES_ENABLED=false
AGENT_API_TIME_ENTRY_WRITES_ENABLED=true

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

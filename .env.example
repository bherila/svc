APP_NAME=SVC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SVC_FILESYSTEM_DISK=svc_files
SVC_FILESYSTEM_ROOT=
# Enable only after the verified reader floor has its persistent privacy latch.
SVC_ATTACHMENT_PRIVATE_UPLOADS_ENABLED=false
# R2 controls stay off until the reader/fallback floor and privacy latch are verified.
SVC_ATTACHMENT_SHARING_WRITES_ENABLED=false
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER options: hybrid (Brevo API -> SMTP failover), brevo (Brevo API only), smtp, log
MAIL_MAILER=hybrid
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Brevo v3 API key DSN, e.g. brevo+api://xkeysib-YOUR_KEY@default
MAILER_DSN=
# Shared secret for the Brevo delivery-status webhook. Point Brevo at
# POST /api/webhooks/brevo and have it send this as an X-Webhook-Token header
# or an Authorization: Bearer header. Query-string credentials are rejected.
# Leave it unset and the endpoint refuses every request, which is the safe state
# for a deployment that has not configured it.
BREVO_WEBHOOK_TOKEN=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OAUTH_PROVIDER=identity
OAUTH_PROVIDER_URL=https://id.bherila.net
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI="${APP_URL}/oauth/callback"

# Exact comma-separated browser origins allowed to call the remote MCP endpoint.
# Native MCP clients that send no Origin header do not need to be listed.
AGENT_API_MCP_ALLOWED_ORIGINS=
AGENT_API_MCP_ALLOWED_HOSTS=
AGENT_API_MCP_MAX_BODY_BYTES=1048576
AGENT_API_MCP_MAX_RESULT_BYTES=2097152
AGENT_API_MCP_MAX_RESPONSE_BODY_BYTES=4194304
AGENT_API_OAUTH_SERVER_ENABLED=true
AGENT_API_DYNAMIC_CLIENT_RETENTION_DAYS=30
AGENT_API_FIRST_PARTY_OAUTH_CLIENTS=
AGENT_API_WRITES_ENABLED=false
AGENT_API_TIME_ENTRY_WRITES_ENABLED=true
AGENT_API_INVOICE_WRITES_ENABLED=false
AGENT_API_EXPENSE_WRITES_ENABLED=false
AGENT_API_PROPOSAL_WRITES_ENABLED=false
AGENT_API_CLIENT_WRITES_ENABLED=false
AGENT_API_PAYMENT_WRITES_ENABLED=false

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Read-only Square pass-through (off while the token or workspace is empty).
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_WORKSPACE=

AGENT_API_PROJECT_WRITES_ENABLED=false
AGENT_API_COLLABORATION_WRITES_ENABLED=false
AGENT_API_WORKSPACE_WRITES_ENABLED=false
AGENT_API_FILE_WRITES_ENABLED=false

# The external finance system that reconciles payments. Its allocations badge a
# payment "Reconciled in finance"; the link is this template with
# {transaction_uuid} replaced. Leave the URL empty for a badge without a link.
SVC_FINANCE_EXTERNAL_SYSTEM=finance
SVC_FINANCE_TRANSACTION_URL=

# Daily scheduled processor movement apply runs (#511). Off until the first
# manual preview's figures are approved; manual runs are unaffected.
SVC_PROCESSOR_MOVEMENTS_SCHEDULED_APPLY=false

# Portal invitations for addresses nobody signs in with yet (#430). Off by default;
# the identity provider must also enable this application for app-requested
# invitations. The key pair signs actor assertions and is used for nothing else.
SVC_PORTAL_INVITATIONS_ENABLED=false
BHERILA_AUTH_INVITATION_KEY_ID=
BHERILA_AUTH_INVITATION_PRIVATE_KEY_PATH=

parameters:
    filesRootDir: %currentWorkingDirectory%

    disallowedFunctionCalls:
        -
            function:
                - 'now()'
                - 'today()'
            message: 'inject the workspace clock helper instead'
            allowExceptIn:
                - app/Services/*
                - app/Support/*

    disallowedStaticCalls:
        -
            method:
                - 'Carbon\Carbon::now()'
                - 'Carbon\Carbon::today()'
                - 'Carbon\CarbonImmutable::now()'
                - 'Carbon\CarbonImmutable::today()'
                - 'Illuminate\Support\Carbon::now()'
                - 'Illuminate\Support\Carbon::today()'
                - 'Illuminate\Support\Facades\Date::now()'
                - 'Illuminate\Support\Facades\Date::today()'
            message: 'inject the workspace clock helper instead'
            allowExceptIn:
                - app/Services/*
                - app/Support/*

services:
    -
        class: Tests\PHPStan\DisallowStatusNegationRule
        tags: [phpstan.rules.rule]
    -
        class: Tests\PHPStan\DisallowUnscopedTenantLookupRule
        tags: [phpstan.rules.rule]
    -
        class: Tests\PHPStan\DisallowBillingEnumDefaultArmRule
        tags: [phpstan.rules.rule]
    -
        class: Tests\PHPStan\DisallowRawLockForUpdateRule
        tags: [phpstan.rules.rule]
